#Copy to terraform.tfvars and edit the values as needed. Do not include the prefix 'tf-' in the keys of vms, it will be added automatically.
#strings
node_name = "pve"
node_ip = "192.0.2.100"
#numbers 
username = "admin"

#lists

ssh_public_key_paths = ["~/.ssh/id_ed25519.pub"]

vms = {
  "test-example" = { vm_id = 304, ip_address = "192.0.2.152" }
  "test-example1" = {vm_id = 303, ip_address = "192.0.2.151" }
}
